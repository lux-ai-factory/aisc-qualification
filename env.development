# Environment for running apps/qualification inside the aisc platform (compose
# merge). Hosts are compose SERVICE NAMES on the shared `backend` network. For
# standalone dev, use .env (see .env.example) instead.

# Shared infra Postgres, host `postgres`; creds mirror the platform's dev defaults.
# Every project has a database of its own (made by the platform), and this app keeps
# a project's AI cards in the `qualification` schema of that database, as its own
# role. `{database}` is filled with `project_<pid without hyphens>` per request
# (src/lib/projectDb.ts), which also forces schema=qualification and
# connection_limit=2. scripts/migrate-projects.mjs (the qualification-migrate
# one-shot) migrates every project database at start; the web app migrates one the
# first time it opens it.
PROJECT_DATABASE_URL=postgresql://qualification_rw:qualification_rw@postgres:5432/{database}?schema=qualification&connection_limit=2
# The install-wide form library, the only thing this app keeps in `platform`
# (schema form_library, owned by this role; used once the forms work is merged).
FORM_LIBRARY_DATABASE_URL=postgresql://qualification_rw:qualification_rw@postgres:5432/platform?schema=form_library&connection_limit=2

# LiteLLM service sidecar. The provider key lives on the qualification-llm
# service (set via the platform env), not here.
LLM_SERVICE_URL=http://qualification-llm:4000

# System-card PDF renderer sidecar.
SYSTEM_CARD_RENDERER_URL=http://qualification-pdf:8005

# AIRO ontology service sidecar.
ONTOLOGY_SERVICE_URL=http://qualification-ontology:8011

# Where the platform names projects and systems. A qualification describes a
# system, and only the platform writes `core.system`, so this is how it is named.
PLATFORM_URL=http://platform:8000

# Where projects are chosen. Reached without one, this app sends the reader
# there rather than asking a second time.
LAUNCHER_URL=http://localhost:8100/
