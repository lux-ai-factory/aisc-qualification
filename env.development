# Environment for running apps/qualification inside the aisc platform (compose
# merge). Hosts are compose SERVICE NAMES on the shared `backend` network. For
# standalone dev, use .env (see .env.example) instead.

# Shared infra Postgres — host `postgres`, creds mirror the platform's dev
# defaults. Uses a DEDICATED `qualification` database (must exist first; the web
# container runs `prisma db push` on start but does not create the DB).
DATABASE_URL=postgresql://aisc-postgres-user:dev-password@postgres:5432/qualification?schema=public

# LiteLLM service sidecar. The provider key lives on the qualification-llm
# service (set via the platform env), not here.
LLM_SERVICE_URL=http://qualification-llm:4000

# System-card PDF renderer sidecar.
SYSTEM_CARD_RENDERER_URL=http://qualification-pdf:8005
