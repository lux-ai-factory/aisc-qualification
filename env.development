# Environment for running apps/qualification inside the aisc platform (compose
# merge). Hosts are compose service names on the shared `backend` network. For
# standalone development use .env (see .env.example) instead.

# Shared infra Postgres, host `postgres`, with the platform's development credentials.
# Every project has its own database (created by the platform), and this app keeps a
# project's AI cards in the `qualification` schema of that database, under its own
# role. src/lib/projectDb.ts fills `{database}` with `project_<pid without hyphens>`
# per request and forces schema=qualification and connection_limit=2.
# scripts/migrate-projects.mjs (the qualification-migrate one-shot) migrates every
# project database at start; the web app migrates a new one the first time it opens it.
PROJECT_DATABASE_URL=postgresql://qualification_rw:qualification_rw@postgres:5432/{database}?schema=qualification&connection_limit=2

# LiteLLM service sidecar. The provider key lives on the qualification-llm
# service (set via the platform env), not here.
LLM_SERVICE_URL=http://qualification-llm:4000

# System-card PDF renderer sidecar.
SYSTEM_CARD_RENDERER_URL=http://qualification-pdf:8005

# AIRO ontology service sidecar.
ONTOLOGY_SERVICE_URL=http://qualification-ontology:8011

# The platform service, which names projects and systems. A qualification describes
# a system, and only the platform writes `core.system`.
PLATFORM_URL=http://platform:8000

# The launcher, where a project is chosen. A request without a project is
# redirected there.
LAUNCHER_URL=http://localhost:8100/
