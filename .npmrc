# This app pins a React 19 release candidate (see package.json). A pre-release
# version does not satisfy an ordinary semver range, so any dependency declaring
# `peer react >= 17` is rejected by strict peer resolution even though it supports
# React 19 perfectly well. @xyflow/react is the case that forced this.
#
# Drop this line once react/react-dom move to a stable 19.x.
legacy-peer-deps=true
