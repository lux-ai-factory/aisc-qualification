# The card agent as the AISC stack builds it (docker-compose.development.yml at the
# repository root): the build context is this directory, and the drafting prompt of
# the ontology service comes in as the named context `ontology-prompts`.
FROM python:3.12.15-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704

WORKDIR /srv

COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY . ./
COPY --from=ontology-prompts . ./ontology-prompts/

# runs as its own user, not root
# BAF opens application.log in the working folder when it is imported, so that one file is the user's, and
# downloads its NLTK data into the home folder, so the user has one
RUN useradd --system --uid 10042 --create-home agents \
 && touch /srv/application.log && chown agents /srv/application.log
USER agents
EXPOSE 8012
CMD ["uvicorn", "service:app", "--host", "0.0.0.0", "--port", "8012"]
