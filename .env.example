# Postgres
DATABASE_URL="postgresql://app:app@localhost:5433/qualification?schema=public"

# The model belongs to the filler service (services/agents), which configures it
# through BAF. The Next.js app makes no LLM calls at all. Leave these unset and
# the app still works: the card is built from your answers, with the two
# prose-derived properties empty until the filler runs.
# BAF_LLM_PROVIDER="mistral"          # or anthropic, openai, ollama, compatible, ...
# BAF_LLM_MODEL="mistral-large-latest"
# BAF_LLM_BASE_URL=""                 # for ollama or compatible
MISTRAL_API_KEY=""
# ANTHROPIC_API_KEY=""

# System-card PDF renderer (services/system_card_renderer)
SYSTEM_CARD_RENDERER_URL="http://localhost:8005"

# AIRO ontology service (services/ontology).
ONTOLOGY_SERVICE_URL=http://localhost:8011
