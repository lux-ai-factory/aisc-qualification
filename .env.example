# Postgres
DATABASE_URL="postgresql://app:app@localhost:5433/qualification?schema=public"

# LiteLLM service (services/llm). The app calls this over HTTP for all LLM work —
# there is no provider SDK or key in the Next.js app itself.
LLM_SERVICE_URL="http://localhost:4000"
# Optional model override (the LiteLLM service defaults to Mistral).
# LLM_MODEL="mistral/mistral-large-latest"

# Provider key(s) used BY THE LiteLLM SERVICE, not by the app. docker-compose
# passes these through to the `llm` container. Set the one matching LLM_MODEL.
MISTRAL_API_KEY=""
# ANTHROPIC_API_KEY=""   # only if you switch LLM_MODEL to an anthropic/* model

# System-card PDF renderer (services/system_card_renderer)
SYSTEM_CARD_RENDERER_URL="http://localhost:8005"
