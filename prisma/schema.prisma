generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Qualification {
  id                String                @id @default(cuid())
  // The platform project this qualification belongs to, and the card version
  // it describes: a row of core.system, numbered per project. Both are uuids
  // from `core` in the one database. One card per version; every save makes
  // the next version, and only the latest version's card changes. The foreign
  // keys are made in the migration, since Prisma cannot model a key into a
  // schema this app only reads.
  projectId         String                @map("project_id") @db.Uuid
  systemId          String                @unique @map("system_id") @db.Uuid
  systemName        String
  systemVersion     String
  company           String
  description       String
  targetUseCase     String
  targetUsers       String
  targetSystemTags  String[]              @default([])
  sectorTags        String[]              @default([])
  marketFormTags    String[]              @default([])
  localityTags      String[]              @default([])
  intendedDeployers String?
  systemCard        String?
  systemCardJson    Json?
  // The filled AIRO graph is the system card. `ontologyExtracted` holds the
  // agent's prose extraction, `ontologyPatch` a reviewer's corrections keyed by
  // node id; the graph itself is rebuilt from them, never stored as the truth.
  ontologyExtracted Json?
  ontologyPatch     Json?
  ontologyAt        DateTime?             @map("ontology_at") @db.Timestamptz(3)
  systemCardAt      DateTime?             @map("system_card_at") @db.Timestamptz(3)
  systemCardPdfPath String?
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  answers           QualificationAnswer[]
  knowledgeGraph    KnowledgeGraph?
  risks             QualificationRisk[]
  components        CardComponent[]

  @@index([projectId])
  @@map("qualification")
}

// An engine component the card links through an AIRO property (hasModel,
// hasTrainingData, hasTestingData, hasValidationData, hasComponent), with a
// snapshot of what it was when linked, so drift from the engine can be shown.
model CardComponent {
  id              String        @id @default(cuid())
  qualificationId String        @map("qualification_id")
  componentPid    String        @map("component_pid") @db.Uuid
  airoProperty    String        @map("airo_property")
  name            String
  componentType   String        @map("component_type")
  objectName      String        @default("") @map("object_name")
  linkedAt        DateTime      @default(now()) @map("linked_at") @db.Timestamptz(3)
  qualification   Qualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade)

  @@unique([qualificationId, componentPid])
  @@index([componentPid])
  @@map("card_component")
}

// One row of the risk block (question 15): one full AIRO risk chain.
// Ids in `affected` and `impactAreas` come from src/data/airo_vocab.json.
model QualificationRisk {
  id              String        @id @default(cuid())
  qualificationId String
  position        Int
  risk            String
  source          String
  vulnerability   String?
  consequence     String
  affected        String
  impactAreas     String[]      @default([])
  control         String
  followUpControl String?
  qualification   Qualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade)

  @@index([qualificationId])
  @@map("qualification_risk")
}

/// The knowledge graph for one system.
///
/// AIRO is the ontology and VAIR the vocabulary: both are vendored, shared, and
/// describe every system. What belongs to a system is instance data conforming
/// to them, which is a knowledge graph, and this is where it is kept.
///
/// It is still rebuilt from the answers, the draft and the reviewer's patch on
/// every read, so a correction shows at once; this row is the built result,
/// updated when it actually changes. Exports serve these bytes, so the file
/// someone was given and the row are the same document.
model KnowledgeGraph {
  id              String        @id @default(cuid())
  qualificationId String        @unique
  /// The graph's identity: its triples up to blank-node renaming.
  digest          String
  turtle          String
  jsonld          String
  /// What produced it: the schema version and the vendored ontology digests.
  stamp           String[]      @default([])
  nodes           Int
  triples         Int
  builtAt         DateTime      @default(now()) @map("built_at") @db.Timestamptz(3)
  qualification   Qualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade)

  @@map("knowledge_graph")
}

model QualificationAnswer {
  id              String        @id @default(cuid())
  qualificationId String
  toolId          String
  questionId      String
  answer          String
  qualification   Qualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade)

  @@unique([qualificationId, questionId])
  @@index([qualificationId, toolId])
  @@map("qualification_answer")
}
